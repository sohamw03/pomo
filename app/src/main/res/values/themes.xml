<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark launch theme so the starting window matches the app instead of
        flashing white. The runtime theme is drawn by Compose right after. -->
    <style name="Theme.Pomo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
